# GitLab credentials.
#
# Single-account legacy schema:
GITLAB_HOST=gitlab.example.com
GITLAB_TOKEN=glpat-replace-me
GITLAB_WRITE_ENABLED=false

# Multi-account schema (Phase 7) — uncomment and add as many as needed.
# Account name in projects.yaml (gitlab.account) matches the middle segment.
# GITLAB__DEFAULT__HOST=gitlab.example.com
# GITLAB__DEFAULT__TOKEN=glpat-...
# GITLAB__COMPANY_B__HOST=gitlab.company-b.com
# GITLAB__COMPANY_B__TOKEN=glpat-...
